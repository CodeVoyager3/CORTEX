# ── CORTEX server environment ────────────────────────────────────────────────
# Copy to `.env` and fill in real values. Every variable here is read and
# validated by package/config/env.ts — that file is the single source of truth.

# Runtime
NODE_ENV=development
API_PORT=3001
WEBHOOK_PORT=3002

# ── Datastores ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma + pg driver adapter). REQUIRED.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cortex_db
# Redis for BullMQ queues. Defaults to redis://localhost:6379 if unset.
REDIS_URL=redis://localhost:6379

# ── Pinecone (vector store + inference embeddings) ─────────────────────────────
PINECONE_API_KEY=
# Serverless index, 1024-dim cosine, model llama-text-embed-v2.
PINECONE_INDEX=cortex-index

# ── Groq (LLM code review) ─────────────────────────────────────────────────────
GROQ_API_KEY=
# Must be a model your key can access. llama-3.3-70b-versatile is NOT available
# on every key; openai/gpt-oss-120b is a safe default that supports JSON output.
GROQ_MODEL=openai/gpt-oss-120b

# ── GitHub ─────────────────────────────────────────────────────────────────────
# Secret configured on the GitHub App / repo webhook. REQUIRED for webhook-service
# (it refuses to start without it) — used to verify x-hub-signature-256.
GITHUB_WEBHOOK_SECRET=

# GitHub App (preferred, production onboarding). Create an App at
# https://github.com/settings/apps, then:
#   GITHUB_APP_ID          → the App ID (numeric) shown on the App settings page.
#   GITHUB_APP_PRIVATE_KEY → the .pem contents. Escape newlines as \n if inline.
#   GITHUB_APP_SLUG        → the App URL slug, used to build the install link.
# When APP_ID + PRIVATE_KEY are set, repo actions use short-lived installation
# tokens; otherwise the server falls back to GITHUB_TOKEN (PAT).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# Personal Access Token fallback (used when no installationId / App not configured).
# Fine for local testing; prefer the GitHub App in production.
GITHUB_TOKEN=
